{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apfw.local/schemas/workflow-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflow",
    "core",
    "profiles",
    "adapters",
    "runtime",
    "schemas_version",
    "normative_artifacts",
    "release"
  ],
  "properties": {
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "status"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "deprecated"
          ]
        }
      }
    },
    "core": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "adapters": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python"
      ],
      "properties": {
        "python": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "schemas_version": {
      "type": "string",
      "minLength": 1
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reproducible",
        "archive",
        "sidecar",
        "qa_reports"
      ],
      "properties": {
        "reproducible": {
          "type": "boolean"
        },
        "archive": {
          "type": "string",
          "minLength": 1
        },
        "sidecar": {
          "type": "string",
          "minLength": 1
        },
        "qa_reports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "normative_artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
