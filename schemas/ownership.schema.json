{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apfw.local/schemas/ownership.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "owners"
  ],
  "properties": {
    "owners": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      }
    }
  }
}
