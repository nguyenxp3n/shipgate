{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apfw.local/schemas/test-invariant.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "owner",
    "active_from_wp",
    "required_tests"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]{1,63}$"
    },
    "owner": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "active_from_wp": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]{1,63}$"
    },
    "required_tests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "description": {
      "type": "string",
      "minLength": 1
    }
  }
}
