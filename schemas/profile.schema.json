{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apfw.local/schemas/profile.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "required_capabilities", "optional_capabilities", "validators"],
  "properties": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "workflow_core_compatibility"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "workflow_core_compatibility": {"type": "string", "minLength": 1}
      }
    },
    "required_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "optional_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "validators": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
