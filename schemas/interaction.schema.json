{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apfw.local/schemas/interaction.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "producer",
    "consumer",
    "transaction_boundary",
    "idempotency",
    "timeout",
    "failure_behavior"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]{1,63}$"
    },
    "type": {
      "type": "string",
      "enum": [
        "SYNC_QUERY",
        "SYNC_COMMAND",
        "SAME_REQUEST_ORCHESTRATION",
        "DOMAIN_EVENT",
        "BACKGROUND_JOB",
        "OUTBOX_EVENT",
        "EXTERNAL_WEBHOOK"
      ]
    },
    "producer": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "consumer": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "transaction_boundary": {
      "type": "string",
      "minLength": 1
    },
    "idempotency": {
      "type": "string",
      "minLength": 1
    },
    "timeout": {
      "type": "string",
      "minLength": 1
    },
    "failure_behavior": {
      "type": "string",
      "minLength": 1
    }
  }
}
